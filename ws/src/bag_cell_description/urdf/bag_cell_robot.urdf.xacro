<?xml version="1.0"?>
<!-- UR10e + suction cup, for the baggage cell.
     Same as ur_simulation_gz/urdf/ur_gz.urdf.xacro, plus the suction tool at the end. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro"/>

  <xacro:arg name="ur_type" default="ur10e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find bag_cell_description)/config/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="ros_namespace" default=""/>

  <link name="world"/>

  <!-- the arm -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="true">
    <!-- robot base on top of a 30 cm pedestal (the pedestal itself is in the world file) -->
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ===== suction tool ===== -->
  <!-- ONE link with two shapes (tube + cup), so MoveIt cannot see them colliding with each other.
       Tube - 12 cm long, starts 5 mm off the flange (the tool0 z axis points out of the flange).
       Cup - wider pad at the end, from 0.125 to 0.145 m. -->
  <link name="suction_tool">
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.12"/></geometry>
      <material name="suction_grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.135" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.02"/></geometry>
      <material name="suction_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.12"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.135" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.08"/>
      <mass value="0.6"/>
      <inertia ixx="0.0015" iyy="0.0015" izz="0.0006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="suction_tool_joint" type="fixed">
    <parent link="tool0"/>
    <child link="suction_tool"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- TCP - the point that touches the bag (no geometry), at the cup face. -->
  <link name="suction_tip"/>
  <joint name="suction_tip_joint" type="fixed">
    <parent link="suction_tool"/>
    <child link="suction_tip"/>
    <origin xyz="0 0 0.145" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo + ros2_control (same as the UR simulation) -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <ros><namespace>$(arg ros_namespace)</namespace></ros>
    </plugin>
  </gazebo>

  <!-- start pose = the UR default (arm straight up), base turned 90 deg right to face the belt -->
  <xacro:ur_ros2_control
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    transmission_hw_interface="$(arg transmission_hw_interface)"
    initial_positions="${dict(shoulder_pan_joint=-1.5708,shoulder_lift_joint=-1.57,elbow_joint=0.0,wrist_1_joint=-1.57,wrist_2_joint=0.0,wrist_3_joint=0.0)}"/>
</robot>
